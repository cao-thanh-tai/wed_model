{
  "model_name": "fruit_classifier",
  "architecture": "resnet18",
  "input": {
    "name": "images",
    "layout": "NCHW",
    "color_order": "RGB",
    "image_size": 224,
    "dtype": "float32",
    "normalize_mean": [
      0.485,
      0.456,
      0.406
    ],
    "normalize_std": [
      0.229,
      0.224,
      0.225
    ]
  },
  "output": {
    "name": "logits",
    "activation": "softmax",
    "description": "Apply softmax to logits in the web client."
  },
  "classes": [
    "apple",
    "avocado",
    "banana",
    "cherry",
    "kiwi",
    "mango",
    "orange",
    "pinenapple",
    "strawberries",
    "watermelon"
  ],
  "class_to_index": {
    "apple": 0,
    "avocado": 1,
    "banana": 2,
    "cherry": 3,
    "kiwi": 4,
    "mango": 5,
    "orange": 6,
    "pinenapple": 7,
    "strawberries": 8,
    "watermelon": 9
  },
  "opset_version": 17,
  "source_checkpoint": "models\\resnet18\\best_model.pt"
}